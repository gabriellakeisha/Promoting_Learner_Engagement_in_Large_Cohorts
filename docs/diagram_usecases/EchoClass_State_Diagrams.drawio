  <diagram id="session-state" name="Session State Diagram">
    <mxGraphModel dx="2647" dy="1024" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="550" math="0" shadow="0">
      <root>
        <mxCell id="0" />
