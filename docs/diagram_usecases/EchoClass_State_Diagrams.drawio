        <mxCell id="note" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#999;fontSize=15;align=left;spacingLeft=8;labelBackgroundColor=none;" value="&lt;b&gt;Design Decision:&lt;/b&gt; Messages are never physically deleted.&lt;br&gt;Soft-deletion preserves the audit trail. Reported messages&lt;br&gt;are removed from the chatroom but preserved in the CSV&lt;br&gt;export with a REPORTED status tag." vertex="1">
