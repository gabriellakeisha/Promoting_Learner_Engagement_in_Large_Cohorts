        <mxCell id="t3" edge="1" parent="1" source="active" style="endArrow=block;html=1;fontSize=15;fontColor=#666666;labelBackgroundColor=none;" target="ended" value="POST /:sessionId/end&lt;br&gt;(lecturer ends session)">
