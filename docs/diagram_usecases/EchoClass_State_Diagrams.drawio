        <mxCell id="t1" edge="1" parent="1" source="init" style="endArrow=block;html=1;fontSize=15;fontColor=#666666;curved=1;labelBackgroundColor=none;" target="scheduled" value="POST /create&lt;br&gt;{isScheduled: true}">
