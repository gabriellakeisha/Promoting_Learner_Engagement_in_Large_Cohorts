        <mxCell id="t1b" edge="1" parent="1" source="init" style="endArrow=block;html=1;fontSize=15;fontColor=#666666;curved=1;labelBackgroundColor=none;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="active" value="POST /create&lt;br&gt;{default: active}">
