  <diagram id="message-state" name="Message State Diagram">
    <mxGraphModel dx="1344" dy="931" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;labelBackgroundColor=none;" value="&lt;b&gt;Figure 5: Message State Diagram&lt;/b&gt;" vertex="1">
          <mxGeometry height="25" width="350" x="1190" y="122.5" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="59" y="260" as="geometry" />
        </mxCell>
        <mxCell id="created" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;arcSize=15;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Created&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;text = original content&lt;br&gt;isEdited = false&lt;br&gt;isDeleted = false&lt;br&gt;isReported = false&lt;br&gt;isPinned = false" vertex="1">
          <mxGeometry height="150" width="210" x="200" y="200" as="geometry" />
        </mxCell>
        <mxCell id="edited" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1976D2;arcSize=15;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Edited&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;text = new content&lt;br&gt;isEdited = true&lt;br&gt;editHistory[] += previous text&lt;br&gt;originalText preserved&lt;br&gt;&lt;i&gt;(Edited) label shown&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="550" y="60" as="geometry" />
        </mxCell>
        <mxCell id="pinned" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;arcSize=15;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Pinned&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;isPinned = true&lt;br&gt;&lt;i&gt;Appears at top of chat&lt;br&gt;Toggle on/off by lecturer&lt;/i&gt;" vertex="1">
          <mxGeometry height="120" width="200" x="550" y="250" as="geometry" />
        </mxCell>
        <mxCell id="reported" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;arcSize=15;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Reported&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;isReported = true&lt;br&gt;reportedBy = userId (FK)&lt;br&gt;reportedAt = timestamp&lt;br&gt;&lt;i&gt;Removed from chatroom&lt;br&gt;Preserved in CSV export only&lt;/i&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="550" y="410" as="geometry" />
        </mxCell>
        <mxCell id="deleted" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;arcSize=15;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Soft-Deleted&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;isDeleted = true&lt;br&gt;deletedBy = userId (FK)&lt;br&gt;deletedAt = timestamp&lt;br&gt;originalText preserved in DB&lt;br&gt;&lt;i&gt;&#39;This message was deleted&#39;&lt;br&gt;placeholder shown to users&lt;/i&gt;" vertex="1">
          <mxGeometry height="170" width="230" x="880" y="200" as="geometry" />
