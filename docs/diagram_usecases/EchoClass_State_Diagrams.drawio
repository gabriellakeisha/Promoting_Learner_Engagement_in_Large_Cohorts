          <mxGeometry height="25" width="350" x="350" y="20" as="geometry" />
        </mxCell>
        <mxCell id="init" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="-53" y="196" as="geometry" />
        </mxCell>
        <mxCell id="scheduled" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;arcSize=20;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Scheduled&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;status = &#39;scheduled&#39;&lt;br&gt;startTime = future date&lt;br&gt;endTime = planned end&lt;br&gt;Students cannot send messages" vertex="1">
          <mxGeometry height="150" width="230" x="137" y="131" as="geometry" />
        </mxCell>
        <mxCell id="active" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;arcSize=20;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Active&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;status = &#39;active&#39;&lt;br&gt;startTime = now&lt;br&gt;Messages enabled&lt;br&gt;Analytics available on demand&lt;br&gt;Confusion spike computed per request" vertex="1">
          <mxGeometry height="180" width="260" x="500" y="115" as="geometry" />
        </mxCell>
        <mxCell id="ended" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#9E9E9E;arcSize=20;align=center;verticalAlign=top;spacingTop=5;fontSize=15;labelBackgroundColor=none;" value="&lt;b&gt;Ended&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;status = &#39;ended&#39;&lt;br&gt;endTime = timestamp&lt;br&gt;Messages read-only&lt;br&gt;Analytics still accessible&lt;br&gt;AI summary available&lt;br&gt;CSV export available" vertex="1">
          <mxGeometry height="180" width="230" x="850" y="115" as="geometry" />
        </mxCell>
        <mxCell id="final" parent="1" style="ellipse;fillColor=#000000;strokeColor=#000000;shape=doubleCircle;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1120" y="190" as="geometry" />
