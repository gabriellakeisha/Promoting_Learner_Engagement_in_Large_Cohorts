# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:<number>/<example_lecture_engagement_mvp>

# Session Secret
SESSION_SECRET=your-random-secret-string-here

# Session Configuration
SESSION_MAX_AGE=86400000

# Lecturer Registration Code
LECTURER_ACCESS_CODE=set_lecturer_private_code_here

# AI Summary (Hugging Face)
# Get free API key at: https://huggingface.co/settings/tokens
# If not set, the system uses RAKE for keywords and skips AI summaries
HUGGINGFACE_API_KEY=hf_your_api_key_here
